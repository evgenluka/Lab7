// Одномерные массивы и статистика элементов

#include <stdio.h>

#define MAX_SIZE 100

int main(void)
{
    int a[MAX_SIZE];
    int b[MAX_SIZE];

    int n;
    int i;
    int count = 0;
    int sum = 0;

    /* Проверка размера массива */
    printf("Введите количество элементов: ");

    if (scanf("%d", &n) != 1) {
        printf("Ошибка: введите целое число.\n");
        return 1;
    }

    if (n <= 0) {
        printf("Ошибка: количество элементов должно быть больше 0.\n");
        return 1;
    }

    if (n > MAX_SIZE) {
        printf("Ошибка: количество элементов не должно превышать %d.\n",
               MAX_SIZE);
        return 1;
    }

    /* Ввод массива */
    printf("Введите %d элементов:\n", n);

    for (i = 0; i < n; i++) {
        if (scanf("%d", &a[i]) != 1) {
            printf("Ошибка: элемент должен быть целым числом.\n");
            return 1;
        }

        /* Ограничение значения элемента */
        if (a[i] < -1000 || a[i] > 1000) {
            printf("Ошибка: элемент %d вне допустимого диапазона.\n",
                   a[i]);
            return 1;
        }
    }

    /* Создание массива b */
    for (i = 0; i < n; i++) {
        if (a[i] < 0) {
            b[i] = 0;
            count++;
        } else {
            b[i] = a[i];
        }

        sum += b[i];
    }

    /* Вывод исходного массива */
    printf("\na: ");
    for (i = 0; i < n; i++) {
        printf("%d", a[i]);

        if (i < n - 1) {
            printf(" ");
        }
    }

    /* Вывод второго массива */
    printf("\nb: ");
    for (i = 0; i < n; i++) {
        printf("%d", b[i]);

        if (i < n - 1) {
            printf(" ");
        }
    }

    /* Вывод результатов */
    printf("\nКоличество замен: %d", count);
    printf("\nСумма элементов b: %d\n", sum);

    return 0;
}
